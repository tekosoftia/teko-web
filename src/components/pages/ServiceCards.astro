---
import { t, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const servicesPath = lang === 'es' ? '/es/servicios' : '/en/services';

// Bento layout (lg): tall card on the left, two wide cards stacked on the right.
const cards = [
  { key: 'software', icon: 'code',      index: '01', span: 'lg:row-span-2' },
  { key: 'data',     icon: 'database',  index: '02', span: 'lg:col-span-2' },
  { key: 'ai',       icon: 'neurology', index: '03', span: 'lg:col-span-2' },
];
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 lg:grid-rows-2 gap-4 lg:gap-5">
  {cards.map((card, i) => (
    <article
      class:list={[
        'group relative glass-panel cyber-corner rounded-xl p-6 lg:p-8 flex flex-col gap-4 bg-void/70 backdrop-blur-md border border-accent/15 transition-all duration-300 hover:border-accent/50 hover:shadow-neon hover:-translate-y-1',
        i === 0 ? 'md:col-span-2 lg:col-span-1' : '',
        card.span,
      ]}
    >
      <div class="flex items-center justify-between">
        <div class="size-11 rounded-lg flex items-center justify-center bg-accent/10 border border-accent/30 shadow-[0_0_18px_rgba(56,189,248,0.15)]">
          <span class="material-symbols-outlined text-accent text-[22px]">{card.icon}</span>
        </div>
        <span class="font-mono text-[10px] tracking-[0.2em] text-muted">{card.index}</span>
      </div>

      <h3 class="font-display font-bold text-xl lg:text-2xl text-white leading-tight">
        {t(lang, `home.services.${card.key}.title`)}
      </h3>
      <p class="text-muted text-sm lg:text-base leading-relaxed">
        {t(lang, `home.services.${card.key}.desc`)}
      </p>

      {i === 0 && (
        <!-- Code preview: only in the tall card (real HTML text, crisp) -->
        <pre class="hidden lg:block mt-2 flex-grow rounded-lg border border-white/10 bg-black/40 p-4 font-mono text-[12px] leading-relaxed text-white/70 overflow-hidden" aria-hidden="true"><span class="text-accent">export async function</span> deploy(app) {'{'}
  <span class="text-muted">// tests → build → release</span>
  <span class="text-accent">await</span> pipeline.run(app);
  <span class="text-accent">return</span> {'{'} status: <span class="text-sky-300">'live'</span> {'}'};
{'}'}</pre>
      )}

      <div class="mt-auto flex flex-wrap items-center gap-2 pt-2">
        {(t(lang, `home.services.${card.key}.tags`) as string[]).map((tag) => (
          <span class="tech-tag font-mono text-[11px] text-white/70 px-2 py-1 rounded">{tag}</span>
        ))}
        <a href={servicesPath} class="ml-auto font-mono text-xs text-accent flex items-center gap-1 no-underline opacity-80 group-hover:opacity-100">
          {t(lang, 'home.services.more')}
          <span class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-1">arrow_forward</span>
        </a>
      </div>
    </article>
  ))}
</div>
