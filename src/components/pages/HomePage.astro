---
import { t, type Lang } from '../../i18n/utils';
import HeroScene from './HeroScene.astro';
import HeroScene3D from '../scene/HeroScene3D';
import AwsLogo from '../brand/AwsLogo.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const contactPath = lang === 'es' ? '/es/contacto' : '/en/contact';
// Copy for the 3D scene labels / node detail panel.
const sceneCopy = {
  ...t(lang, 'home.scene.nodes'),
  hint: t(lang, 'home.scene.hint'),
  close: t(lang, 'home.scene.close'),
  ariaLabel: t(lang, 'home.scene.ariaLabel'),
};
const casesPath = lang === 'es' ? '/es/software' : '/en/software';

// Wordmarks rendered as text (swap for official SVG logos when available).
// Wordmarks rendered as text (swap for official SVG logos when available).
// Grouped loosely: AI · Data · Software / Cloud.
const stack = [
  'Claude', 'Meta Llama', 'Hugging Face', 'OpenAI', 'LangChain',
  'Python', 'PostgreSQL', 'Databricks',
  'Docker', 'Kubernetes', 'Terraform', 'React', 'Node.js',
];

---

<main class="relative z-10 flex-grow w-full flex flex-col items-center px-6 overflow-hidden">
  <!-- ── Hero ── -->
  <section class="max-w-[1440px] w-full grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)] gap-8 lg:gap-4 items-center relative py-10 lg:py-6">
    <!-- Left Column: Typography & Action -->
    <div class="flex flex-col gap-7 z-20 order-1">
      <!-- Decorative Label -->
      <div class="flex items-center gap-3">
        <div class="h-[1px] w-12 bg-accent/50"></div>
        <span class="font-mono text-accent text-xs tracking-[0.2em]">{t(lang, 'home.eyebrow')}</span>
      </div>
      <!-- Main Heading -->
      <div class="relative">
        <h1 class="font-display font-extrabold text-[2rem] sm:text-5xl lg:text-[2.6rem] xl:text-[2.9rem] 2xl:text-[3.3rem] leading-[1.06] tracking-tight text-white uppercase">
          {t(lang, 'home.title1')}{' '}
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent via-sky-300 to-accent">{t(lang, 'home.title2')}</span>
        </h1>
        <div class="absolute -z-10 -top-10 -left-10 w-40 h-40 bg-accent/15 blur-3xl rounded-full"></div>
      </div>
      <!-- Subtitle -->
      <p class="font-tech text-lg md:text-xl text-muted max-w-xl border-l-2 border-accent/50 pl-6 py-1 leading-relaxed">
        {t(lang, 'home.subtitle')}
      </p>
      <!-- CTA Area -->
      <div class="pt-2 flex flex-wrap gap-6 items-center">
        <a href={contactPath} class="group relative px-8 py-4 bg-accent text-void font-bold font-display tracking-widest uppercase text-sm overflow-hidden transition-all hover:scale-105 hover:shadow-[0_0_30px_rgba(56,189,248,0.6)] -skew-x-[12deg] glitch-hover no-underline">
          <span class="relative z-10 flex items-center gap-2 skew-x-[12deg]">
            {t(lang, 'home.ctaPrimary')}
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </span>
          <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
        </a>
        <a class="font-mono text-sm text-white/70 hover:text-accent flex items-center gap-2 group transition-colors no-underline uppercase" href={casesPath}>
          <span class="w-8 h-[1px] bg-white/30 group-hover:bg-accent transition-colors"></span>
          {t(lang, 'home.ctaSecondary')}
        </a>
      </div>
    </div>

    <!-- Right Column: Isometric 3D scene (R3F island over a CSS fallback) -->
    <div class="relative order-2 w-full" data-scene-root>
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[70%] h-[60%] bg-accent/10 blur-[90px] rounded-full"></div>
      </div>
      <div class="scene-fallback">
        <HeroScene lang={lang} />
      </div>
      <HeroScene3D client:only="react" copy={sceneCopy} />
      <noscript><style>[data-scene-root] .scene-fallback{opacity:1!important;visibility:visible!important}</style></noscript>
    </div>
  </section>

  <!-- ── Trust strip: AWS Partner + stack ── -->
  <section class="max-w-[1440px] w-full border-y border-white/10 py-6 flex flex-col md:flex-row md:items-center gap-5 md:gap-10">
    <span class="font-mono text-[11px] tracking-[0.2em] text-muted uppercase shrink-0">{t(lang, 'home.trust.label')}</span>
    <div class="flex items-center gap-8 min-w-0 flex-1">
      <span class="inline-flex items-center gap-3 shrink-0">
        <AwsLogo class="h-9 w-auto shrink-0" />
        <span class="w-px h-8 bg-white/20"></span>
        <span class="font-display font-bold text-base text-white tracking-tight whitespace-nowrap">{t(lang, 'home.trust.partner')}</span>
      </span>
      <!-- Auto-scrolling tech ribbon (duplicated list for a seamless loop) -->
      <div class="tk-marquee min-w-0 flex-1" role="list" aria-label={t(lang, 'home.trust.label')}>
        <div class="tk-marquee-track">
          {[0, 1].map((copy) => (
            <div class="tk-marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
              {stack.map((name) => (
                <span role={copy === 0 ? 'listitem' : undefined} class="font-display font-bold text-lg text-white/40 hover:text-white/80 transition-colors tracking-tight whitespace-nowrap">{name}</span>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

</main>

<script>
  // Decide early (before the 3D bundle loads) whether this device gets the CSS scene,
  // so visitors never see the fallback flash before the 3D version.
  const root = document.querySelector<HTMLElement>('[data-scene-root]');
  if (root) {
    const nav = navigator as Navigator & { deviceMemory?: number; connection?: { saveData?: boolean } };
    let webgl = false;
    try {
      const c = document.createElement('canvas');
      webgl = !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch { webgl = false; }
    const lowEnd = !!nav.connection?.saveData || (nav.hardwareConcurrency ?? 8) <= 2 || (nav.deviceMemory ?? 8) <= 2;
    if (!webgl || lowEnd) root.classList.add('is-css');
    // Safety net: if the 3D scene isn't ready in 8s, show the CSS version.
    setTimeout(() => { if (!root.classList.contains('is-3d')) root.classList.add('is-css'); }, 8000);
  }
</script>
