---
/**
 * AWS logo (wordmark + "smile" arrow) as inline SVG.
 * Replace with the official asset from AWS Partner Central / AWS brand guidelines
 * if the brand team requires the exact file.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 64 40" role="img" aria-label="AWS" xmlns="http://www.w3.org/2000/svg">
  <text x="32" y="23" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="25" font-weight="700" fill="#FFFFFF" letter-spacing="-0.5">aws</text>
  <path d="M7 29.5 C 21 37.5, 41 37.5, 54 29" fill="none" stroke="#FF9900" stroke-width="3.2" stroke-linecap="round" />
  <path d="M48.5 27.2 L 55.6 28.2 L 53.4 34.8" fill="none" stroke="#FF9900" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
</svg>
